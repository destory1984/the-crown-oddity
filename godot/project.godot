; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Crown Oddity"
config/version="0.0.68"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/updated="2026-10-25"

[autoload]

McpRuntimeAutoload="*res://addons/open_godot_mcp/runtime/runtime_autoload.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/open_godot_mcp/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://i18n/text.ko.translation")

[open_godot_mcp]

screenshot_max_count=50
screenshot_max_age_hours=24

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
scaling_3d/scale=0.75
